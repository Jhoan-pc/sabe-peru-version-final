rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Platos de la carta: lectura pública, administración autenticada
    match /menu_items/{item} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Contenido dinámico del sitio (textos e imágenes): lectura pública, administración autenticada
    match /site_content/{content} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Reservas de clientes: creación pública, gestión operativa autenticada
    match /reservations/{resId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
    
    // Galería fotográfica Cloudinary SSOT: lectura pública, gestión autenticada
    match /gallery_items/{galleryId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
  }
}
